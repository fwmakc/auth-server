NODE_ENV=development
IP=localhost
PORT=3001
ROOT_PATH=.

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_server
DB_USER=root
DB_PASSWORD=
DB_LOG=false

# RS256 keys: if paths omitted, keys auto-generated in memory (dev only)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_CLIENTS_EXPIRES=

# Issuer URL (default: http://IP:PORT, set to https in production)
# ISSUER=https://auth.example.com

# Password policy — a variable set (true/1/yes/on) means the rule is enforced.
# Defaults: min 6 / max 72 (bcrypt byte limit), no complexity requirements.
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=72
# PASSWORD_REQUIRE_LOWER=true
# PASSWORD_REQUIRE_UPPER=true
# PASSWORD_REQUIRE_DIGITS=true
# PASSWORD_REQUIRE_SYMBOLS=true

# Two-factor authentication (TOTP + email code). Master switch is off by default:
# with TWO_FACTOR_ENABLED unset/false no login is ever challenged.
TWO_FACTOR_ENABLED=false
# Issuer shown in the TOTP app (otpauth URI)
TWO_FACTOR_ISSUER=Auth
# Short-lived challenge token issued between password check and 2FA verification
JWT_MFA_EXPIRES=5m

# Internal info cache TTL (seconds) — sent as Cache-Control header to consumers
# Consumers (api-server) read this via Cache-Control: max-age=N
INTERNAL_INFO_CACHE_TTL=30

# Authorization code HMAC secret (use AES_SECRET if not set)
# CODE_HMAC_SECRET=

# Encryption
AES_SECRET=change_me_to_32_characters__

# OAuth providers
OAUTH_SERVER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_REDIRECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

LEADER_CLIENT_ID=
LEADER_CLIENT_SECRET=
LEADER_CLIENT_REDIRECT=

UNTI_CLIENT_ID=
UNTI_CLIENT_SECRET=
UNTI_CLIENT_REDIRECT=

# Form redirect URLs (post-login screens)
FORM_LOGIN=
FORM_REGISTER=
FORM_RESET=

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Admin access (toolkit) — JWT field and value checked by downstream services
SUPERUSER_FIELD=isSuperuser
SUPERUSER_VALUE=true

# Event server (for publishing account lifecycle events)
EVENT_SERVER_URL=http://localhost:3005

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Auth Server API
SWAGGER_DESCRIPTION=OAuth2 Authorization Server
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
LOG_FORMAT=console # LOG_FORMAT=json for structured logs + request id
MORGAN_LOG_FORMAT=dev
