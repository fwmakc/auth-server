NODE_ENV=development
IP=localhost
PORT=3001
ROOT_PATH=.

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_server
DB_USER=root
DB_PASSWORD=
DB_SYNCHRONIZE=true
DB_LOG=true

# RS256 keys: if paths omitted, keys auto-generated in memory (dev only)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_CLIENTS_EXPIRES=
JWT_EXPIRES=true

# Encryption
AES_SECRET=change_me_to_32_characters__

# SMTP (for email verification emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=

# OAuth providers
OAUTH_SERVER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_REDIRECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

LEADER_CLIENT_ID=
LEADER_CLIENT_SECRET=
LEADER_CLIENT_REDIRECT=

UNTI_CLIENT_ID=
UNTI_CLIENT_SECRET=
UNTI_CLIENT_REDIRECT=

# Form redirect URLs (post-login screens)
FORM_LOGIN=
FORM_REGISTER=
FORM_RESET=

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Admin access (toolkit) — JWT field and value checked by downstream services
SUPERUSER_FIELD=isSuperuser
SUPERUSER_VALUE=true

# Event server (for publishing account lifecycle events)
EVENT_SERVER_URL=http://localhost:3005

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Auth Server API
SWAGGER_DESCRIPTION=OAuth2 Authorization Server
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
MORGAN_LOG_FORMAT=
