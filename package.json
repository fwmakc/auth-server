{
  "name": "auth-server",
  "version": "0.6.0",
  "description": "OAuth2 authorization server — registration, login, JWT issuance, social login",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "github:fwmakc/auth-server"
  },
  "keywords": [
    "nestjs",
    "oauth2",
    "jwt",
    "rs256",
    "jwks",
    "authentication",
    "authorization",
    "social-login",
    "passport"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/auth-server/issues"
  },
  "homepage": "https://github.com/fwmakc/auth-server#readme",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "test": "cross-env TZ=UTC jest --runInBand",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "ai-context": "node node_modules/api-server-toolkit/scripts/generate-service-context.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:auto": "npm run typeorm migration:generate -- -d ./src/config/typeorm.config.ts ./src/typeorm/migrations/auto",
    "migration:create": "npm run typeorm migration:create --",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/typeorm.config.ts",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:fake": "npm run migration:run -- --fake"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@casl/ability": "^6.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.69.0",
    "@supercharge/request-ip": "^1.2.0",
    "api-server-toolkit": "github:fwmakc/api-server-toolkit#v0.13.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "event-server": "github:fwmakc/event-server#v1.0.0",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "json-2-csv": "^5.5.9",
    "mime-types": "^2.1.35",
    "moment": "^2.29.4",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.22.0",
    "redoc-express": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.4.15",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.3.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.0.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "webpack": "^5.108.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  }
}
